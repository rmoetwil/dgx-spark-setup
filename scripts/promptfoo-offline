#!/usr/bin/env bash
# Run promptfoo with everything that contacts promptfoo's servers switched off:
# telemetry, update checks, remote test generation and sharing.
# Link it as ~/.local/bin/promptfoo, so promptfoo never runs without these settings.
# These settings are not a firewall: block outbound traffic as well before using sensitive test cases.
set -euo pipefail

export PROMPTFOO_DISABLE_TELEMETRY=1
export PROMPTFOO_DISABLE_UPDATE=1
export PROMPTFOO_DISABLE_REMOTE_GENERATION=true
export PROMPTFOO_DISABLE_SHARING=1
export PROMPTFOO_SELF_HOSTED=1

# llama-swap may first have to load a model, which can take minutes.
export REQUEST_TIMEOUT_MS=${REQUEST_TIMEOUT_MS:-600000}

OPT=$HOME/.local/opt
export PATH=$OPT/node/bin:$PATH
exec "$OPT/promptfoo/bin/promptfoo" "$@"
