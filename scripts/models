#!/usr/bin/env bash
# models: find, download, run and move LLM models across the internal and external disk.
#
# Hugging Face models live in one of two HF caches, selected with HF_HOME:
#   internal  ~/.cache/huggingface       main models, fastest loading
#   external  /mnt/ai-data/huggingface   less-used and experimental models
# Models outside an HF cache (type "local": --local-dir downloads, GGUFs, LM Studio)
# are only listed, not managed; software finds them by path.
set -euo pipefail

INTERNAL_HF=${MODELS_INTERNAL_HF:-$HOME/.cache/huggingface}
EXTERNAL_HF=${MODELS_EXTERNAL_HF:-/mnt/ai-data/huggingface}
FILE_DIRS=${MODELS_FILE_DIRS:-$HOME/data/ai/models:/mnt/ai-data/models}

usage() {
  cat <<'EOF'
Usage: models <command> [args]

  ls                              list models on both disks (disk, type, size, name);
                                  type hf = in an HF cache, local = plain folder
  where <repo>                    print the disk holding <repo>: internal or external
  env <repo>                      print 'export HF_HOME=...' for <repo>; use with eval
  get <repo> [--internal|--external] [...]
                                  hf download into the active cache (see 'use'), or the one
                                  given; extra arguments go to 'hf download'
  use [internal|external]         print the shell code that switches HF_HOME; without an
                                  argument, show the active cache. Use through 'hfuse'
  shell-init                      print the hfuse function and prompt marker for ~/.bashrc:
                                    eval "$(models shell-init)"
  run <repo> -- <command...>      run <command> with HF_HOME set to the cache holding <repo>
  mv <repo> internal|external     move <repo> to the other cache: copy, verify, then delete
                                  the original; stop anything using the model first

<repo> is a Hugging Face repo ID, such as Qwen/Qwen3-Coder-Next-FP8.
Override paths with MODELS_INTERNAL_HF, MODELS_EXTERNAL_HF and MODELS_FILE_DIRS.
EOF
}

die() { echo "models: $*" >&2; exit 1; }

hf_home() {
  case "$1" in
    internal) echo "$INTERNAL_HF" ;;
    external)
      # The directory lives on the SSD, so it is missing when the SSD is not mounted.
      [ -d "$EXTERNAL_HF" ] || die "$EXTERNAL_HF not found; is the external disk mounted?"
      echo "$EXTERNAL_HF" ;;
    *) die "unknown disk '$1'; use internal or external" ;;
  esac
}

# The cache hf uses when HF_HOME is not set.
HF_DEFAULT=${XDG_CACHE_HOME:-$HOME/.cache}/huggingface

# The disk the current HF_HOME points at: internal, external, or other.
active_disk() {
  case "${HF_HOME:-$HF_DEFAULT}" in
    "$INTERNAL_HF") echo internal ;;
    "$EXTERNAL_HF") echo external ;;
    *) echo other ;;
  esac
}

repo_dir() { echo "$1/hub/models--${2//\//--}"; }   # Qwen/X -> <cache>/hub/models--Qwen--X

# Newer hf versions keep large files in a store shared by all models, <cache>/hub/blobs/<xx>/<sha256>;
# the model's own blobs/ folder then holds a symlink ../../blobs/<xx>/<sha256> to it.
# Print those shared files, relative to <cache>/hub, for the model folder $1.
shared_blobs() {
  [ -d "$1/blobs" ] || return 0
  find "$1/blobs" -type l -printf '%l\n' | sed -n 's|^\.\./\.\./\(blobs/.*\)$|\1|p' | sort -u
}

# Size of a model, following the symlinks into the shared store.
model_size() { du -shL "$1/snapshots" 2>/dev/null | cut -f1; }

check_repo() { [[ "${1:-}" == */* ]] || die "expected a repo ID like org/name, got '${1:-}'"; }

# Print every disk that holds <repo>, one per line.
locate() {
  [ -d "$(repo_dir "$INTERNAL_HF" "$1")" ] && echo internal
  [ -d "$EXTERNAL_HF" ] && [ -d "$(repo_dir "$EXTERNAL_HF" "$1")" ] && echo external
  return 0
}

# Print the single disk to use for <repo>; prefer internal if it is on both.
pick() {
  local found; found=$(locate "$1")
  [ -n "$found" ] || die "$1 is not downloaded; use: models get $1"
  if [ "$(wc -l <<<"$found")" -gt 1 ]; then
    echo "models: $1 is on both disks; using internal" >&2
    echo internal
  else
    echo "$found"
  fi
}

cmd_ls() {
  local disk cache dir name
  printf '%-9s %-5s %6s  %s\n' DISK TYPE SIZE NAME
  for disk in internal external; do
    cache=$INTERNAL_HF; [ "$disk" = external ] && cache=$EXTERNAL_HF
    for dir in "$cache"/hub/models--*/; do
      [ -d "$dir" ] || continue
      name=${dir%/}; name=${name##*/models--}; name=${name/--//}
      printf '%-9s %-5s %6s  %s\n' "$disk" hf "$(model_size "${dir%/}")" "$name"
    done
  done
  local root
  IFS=: read -ra roots <<<"$FILE_DIRS"
  for root in "${roots[@]}"; do
    case "$root" in "$HOME"/*) disk=internal ;; /mnt/ai-data/*) disk=external ;; *) disk=other ;; esac
    for dir in "$root"/*/*/; do
      [ -d "$dir" ] || continue
      name=${dir%/}; name=${name#"$root"/}
      printf '%-9s %-5s %6s  %s\n' "$disk" local "$(du -sh "$dir" 2>/dev/null | cut -f1)" "$root/$name"
    done
  done
}

cmd_where() {
  check_repo "${1:-}"
  local found; found=$(locate "$1")
  [ -n "$found" ] || die "$1 is not downloaded"
  echo "$found"
}

cmd_env() {
  check_repo "${1:-}"
  local disk home
  disk=$(pick "$1")
  home=$(hf_home "$disk")
  echo "export HF_HOME=$home"
}

cmd_get() {
  check_repo "${1:-}"
  local repo=$1 disk; shift
  # Default to the active cache, so 'hfuse external' also steers 'models get'.
  disk=$(active_disk); [ "$disk" = other ] && die "HF_HOME=$HF_HOME is neither cache; pass --internal or --external"
  local args=()
  for a in "$@"; do
    case "$a" in
      --external) disk=external ;;
      --internal) disk=internal ;;
      *) args+=("$a") ;;
    esac
  done
  local other; other=$(locate "$repo" | grep -vx "$disk" || true)
  [ -z "$other" ] || die "$repo is already on the $other disk; use 'models mv' to move it"
  local home; home=$(hf_home "$disk")
  echo "models: downloading $repo to $disk ($home)" >&2
  # ~/.local/bin is only on PATH in interactive shells.
  local hf; hf=$(command -v hf || echo "$HOME/.local/bin/hf")
  [ -x "$hf" ] || die "hf CLI not found; install huggingface_hub"
  HF_HOME=$home "$hf" download "$repo" "${args[@]}"
}

cmd_run() {
  check_repo "${1:-}"
  local repo=$1; shift
  [ "${1:-}" = -- ] && shift
  [ $# -gt 0 ] || die "usage: models run <repo> -- <command...>"
  local disk home
  disk=$(pick "$repo")
  home=$(hf_home "$disk")
  echo "models: HF_HOME=$home" >&2
  HF_HOME=$home exec "$@"
}

cmd_mv() {
  check_repo "${1:-}"
  local repo=$1 to=${2:-}
  [ "$to" = internal ] || [ "$to" = external ] || die "usage: models mv <repo> internal|external"
  local found; found=$(locate "$repo")
  [ -n "$found" ] || die "$repo is not downloaded"
  [ "$(wc -l <<<"$found")" -eq 1 ] || die "$repo is on both disks; delete one copy by hand first"
  [ "$found" != "$to" ] || die "$repo is already on the $to disk"

  local src_home dst_home src dst src_hub dst_hub
  src_home=$(hf_home "$found"); dst_home=$(hf_home "$to")
  src=$(repo_dir "$src_home" "$repo"); dst=$(repo_dir "$dst_home" "$repo")
  src_hub=$src_home/hub; dst_hub=$dst_home/hub
  local shared; shared=$(shared_blobs "$src")

  # Check up front that the original can be deleted; containers download as root.
  local me b; me=$(id -un)
  if [ -n "$(find "$src" ! -user "$me" -print -quit)" ]; then
    die "$src contains files not owned by you; first run: sudo chown -R $me: $src_hub"
  fi
  while IFS= read -r b; do
    [ -z "$b" ] || [ -O "$src_hub/$b" ] || die "$src_hub/$b is not owned by you; first run: sudo chown -R $me: $src_hub"
  done <<<"$shared"

  # Size including the shared files the model links to.
  local need avail
  need=$(du -sbL "$src/snapshots" | cut -f1)
  mkdir -p "$dst_hub"
  avail=$(df --output=avail -B1 "$dst_hub" | tail -1)
  [ "$need" -lt "$avail" ] || die "not enough space on $to: need $need bytes, $avail available"

  echo "models: copying $repo from $found to $to ($(model_size "$src"))" >&2
  local copied=()   # shared files this run added to the destination, for cleanup on failure
  trap 'echo "models: failed; removing partial copy $dst" >&2; rm -rf "$dst"; for b in "${copied[@]}"; do rm -f "$dst_hub/$b"; done' ERR
  rsync -a "$src/" "$dst/"
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    [ -e "$dst_hub/$b" ] && continue   # content-addressed: same name means same content
    mkdir -p "$(dirname "$dst_hub/$b")"
    copied+=("$b")
    rsync -a "$src_hub/$b" "$dst_hub/$b"
  done <<<"$shared"

  echo "models: verifying checksums" >&2
  local broken diffs
  broken=$(find -L "$dst/snapshots" -type l)   # symlinks that do not resolve
  [ -z "$broken" ] || { echo "models: broken links in copy:" >&2; echo "$broken" >&2; false; }
  # cmp follows symlinks on both sides, so it compares the real file contents.
  diffs=$(cd "$src/snapshots" && find . \( -type f -o -type l \) -print | while IFS= read -r f; do
    cmp -s "$f" "$dst/snapshots/$f" || echo "differs or missing: $f"
  done)
  [ -z "$diffs" ] || { echo "$diffs" >&2; false; }
  trap - ERR

  rm -rf "$src" "$src_hub/.locks/models--${repo//\//--}"
  # Delete shared files from the source only when no other model there links to them.
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    if [ -z "$(find "$src_hub" -path "$src_hub/blobs" -prune -o -type l -lname "*/$b" -print -quit)" ]; then
      rm -f "$src_hub/$b"
    fi
  done <<<"$shared"
  echo "models: $repo is now on the $to disk" >&2
}

# Stdout is meant for eval, so all messages go to stderr.
cmd_use() {
  local to=${1:-}
  if [ -z "$to" ]; then
    echo "models: active cache: $(active_disk) (${HF_HOME:-$HF_DEFAULT})" >&2
    return 0
  fi
  local home; home=$(hf_home "$to")
  if [ "$home" = "$HF_DEFAULT" ]; then
    echo "unset HF_HOME"   # back to the default, as in a fresh shell
  else
    printf 'export HF_HOME=%q\n' "$home"
  fi
  echo "models: HF_HOME now points at the $to cache ($home)" >&2
}

cmd_shell_init() {
  cat <<EOF
hfuse() { eval "\$(models use "\$@")"; }
__models_ps1() { [ "\${HF_HOME:-}" = $(printf '%q' "$EXTERNAL_HF") ] && printf '[hf:ext] '; return 0; }
case "\${PS1:-}" in *__models_ps1*) ;; *) PS1='\$(__models_ps1)'"\${PS1:-}" ;; esac
EOF
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
  ls) cmd_ls ;;
  where) cmd_where "$@" ;;
  env) cmd_env "$@" ;;
  get) cmd_get "$@" ;;
  run) cmd_run "$@" ;;
  mv) cmd_mv "$@" ;;
  use) cmd_use "$@" ;;
  shell-init) cmd_shell_init ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 1 ;;
esac
